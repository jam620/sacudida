# Copia este archivo a .env.local y ajusta los valores según tu entorno.

NEXT_PUBLIC_APP_NAME="Sacudida"
NEXT_PUBLIC_DEFAULT_MIN_MAGNITUDE=2.5
NEXT_PUBLIC_REFRESH_SECONDS=60

# Ruta del archivo SQLite (relativa a la raíz del proyecto).
# Usa ":memory:" solo para pruebas. En Vercel no hace falta definirla:
# se usa /tmp automáticamente (caché efímera por instancia).
DATABASE_PATH=./data/sacudida.sqlite

USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
PANAMA_LAT=8.5
PANAMA_LON=-80.5
SEARCH_RADIUS_KM=500

# Desactiva la sincronización automática desde USGS (1 = desactivada).
# Se usa en pruebas para no llamar al servicio real.
# DISABLE_AUTO_SYNC=1

# ── Web Push (avisos aunque la app esté cerrada) ─────────────────────
# Genera tu par de claves con: node scripts/generate-vapid-keys.mjs
# La pública se expone al cliente; la privada NUNCA sale del servidor.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tucorreo@ejemplo.com

# Token que autoriza llamadas externas a /api/push/dispatch
# (el cron de Vercel usa automáticamente CRON_SECRET).
# CRON_SECRET=
# PUSH_DISPATCH_TOKEN=

# ── Fuente local IGC-UP (opcional) ───────────────────────────────────
# El IGC-UP no publica API/feed estable (validado oct-2026). Si en el
# futuro abre un endpoint JSON autorizado, defínelo aquí y el adaptador
# lo importará con deduplicación contra USGS:
# IGC_UP_FEED_URL=https://igc-up.example/feed.json
