{
  "name": "sacudida",
  "version": "0.2.1",
  "private": true,
  "description": "Sacudida — monitoreo informativo de sismos en Panamá con datos públicos de USGS. No predice sismos ni reemplaza alertas oficiales. PWA instalable.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:init": "tsx src/server/database/init.ts",
    "sync": "tsx src/server/etl/sync.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "swr": "^2.5.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
